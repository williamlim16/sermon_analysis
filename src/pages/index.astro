---
import { Image } from 'astro:assets';
import { db } from '../db';
import { sermons } from '../db/schema';
import { desc } from 'drizzle-orm';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await db.select().from(sermons).orderBy(desc(sermons.pubDate));

const themeColors = [
	{ bg: '#fee2e2', text: '#991b1b' }, // red
	{ bg: '#ffedd5', text: '#9a3412' }, // orange
	{ bg: '#fef3c7', text: '#92400e' }, // amber
	{ bg: '#dcfce7', text: '#166534' }, // green
	{ bg: '#ccfbf1', text: '#115e59' }, // teal
	{ bg: '#dbeafe', text: '#1e40af' }, // blue
	{ bg: '#e0e7ff', text: '#3730a3' }, // indigo
	{ bg: '#fae8ff', text: '#86198f' }, // fuchsia
	{ bg: '#fce7f3', text: '#9d174d' }, // pink
];

function getThemeColor(theme: string) {
	let hash = 0;
	for (let i = 0; i < theme.length; i++) {
		hash = theme.charCodeAt(i) + ((hash << 5) - hash);
	}
	return themeColors[Math.abs(hash) % themeColors.length];
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: 100%;
			}
			ul li a {
				display: flex;
				flex-direction: column;
				padding: 1.5rem;
				background: #fff;
				border-radius: 12px;
				box-shadow: 0 4px 6px rgba(var(--black), 5%);
				text-decoration: none;
				transition: all 0.2s ease;
				height: 100%;
				border: 1px solid rgba(var(--gray), 10%);
				box-sizing: border-box;
			}
			ul li a:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-4px);
			}
			ul li img {
				margin-bottom: 1rem;
				border-radius: 8px;
				width: 100%;
				height: auto;
				object-fit: cover;
				aspect-ratio: 16/9;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				line-height: 1.3;
				font-size: 1.4rem;
				font-weight: 700;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				margin-top: auto;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--accent);
			}
			.themes {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1rem;
			}
			.theme {
				padding: 0.25rem 0.75rem;
				border-radius: 999px;
				font-size: 0.75rem;
				font-weight: 600;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				main {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h4 class="title">{post.title || post.fileName}</h4>
									<p class="date">
										<FormattedDate date={post.pubDate} />
									</p>
									{post.theme && post.theme.length > 0 && (
										<div class="themes">
											{post.theme.map((t) => {
												const color = getThemeColor(t);
												return (
													<span 
														class="theme" 
														style={`background-color: ${color.bg}; color: ${color.text};`}
													>
														{t}
													</span>
												);
											})}
										</div>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
