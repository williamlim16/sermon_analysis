---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string | null;
	speaker?: string | null;
	themes?: string[] | null;
}

const { title, description, pubDate, updatedDate, heroImage, speaker, themes } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
				color: rgb(var(--gray-dark));
				font-size: 1.1rem;
				line-height: 1.8;
			}
			.title {
				margin-bottom: 2em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.metadata {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 1.5em;
			}
			.themes {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem;
				margin-top: 0.5rem;
			}
			.theme {
				padding: 0.25rem 0.75rem;
				border-radius: 999px;
				font-size: 0.85rem;
				font-weight: 600;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="metadata">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="last-updated-on">
											(Last updated on <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</div>
							{speaker && <div class="speaker"><strong>Speaker:</strong> {speaker}</div>}
							
							{themes && themes.length > 0 && (
								<div class="themes">
									{themes.map((theme: string) => {
										// Simple hash for colors
										let hash = 0;
										for (let i = 0; i < theme.length; i++) {
											hash = theme.charCodeAt(i) + ((hash << 5) - hash);
										}
										const colors = [
											{ bg: '#fee2e2', text: '#991b1b' },
											{ bg: '#ffedd5', text: '#9a3412' },
											{ bg: '#fef3c7', text: '#92400e' },
											{ bg: '#dcfce7', text: '#166534' },
											{ bg: '#ccfbf1', text: '#115e59' },
											{ bg: '#dbeafe', text: '#1e40af' },
											{ bg: '#e0e7ff', text: '#3730a3' },
											{ bg: '#fae8ff', text: '#86198f' },
											{ bg: '#fce7f3', text: '#9d174d' },
										];
										const color = colors[Math.abs(hash) % colors.length];
										return (
											<span 
												class="theme" 
												style={`background-color: ${color.bg}; color: ${color.text};`}
											>
												{theme}
											</span>
										);
									})}
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
