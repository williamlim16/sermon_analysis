---
interface Props {
	date?: Date | string | null;
}

let { date } = Astro.props;
if (!date) {
	date = new Date();
}

let dateObj: Date;
if (typeof date === 'string') {
	dateObj = new Date(date.includes('T') ? date : `${date}T12:00:00Z`);
} else {
	dateObj = date;
}
---

<time datetime={dateObj.toISOString()}>
	{
		dateObj.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
