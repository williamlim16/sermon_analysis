      display: none;
    }
    .tab-btn {
      padding: 0.35rem 0.65rem;
      font-size: 0.78rem;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .panes-container {
      padding: 1.15rem 1rem 1.5rem 1rem;
    }
    .model-meta {
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .summary-section {
      margin-bottom: 1.5rem;
      padding-left: 0.85rem;
    }
    .summary-text {
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .feedback-group {
      margin-bottom: 1.5rem;
    }
    .group-title {
      font-size: 0.95rem !important;
    }
    .feedback-list li {
      padding-left: 1.25rem !important;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .prose-body {
      font-size: 0.92rem;
      line-height: 1.6;
    }
    .prose-body :global(h1),
    .prose-body :global(h2),
    .prose-body :global(h3),
    .prose-body :global(h4) {
      font-size: 1.05rem !important;
      margin-top: 1.25em;
      margin-bottom: 0.4em;
    }
    .prose-body :global(ul),
    .prose-body :global(ol) {
      padding: 0;
      margin-bottom: 1.25rem;
      gap: 0.4rem;
    }
    .prose-body :global(li) {
      padding-left: 1.15rem;
      font-size: 0.92rem;
      line-height: 1.5;
    }
    .prose-body :global(blockquote) {
      padding: 0.75rem 0.85rem;
      margin: 1.15rem 0;
      font-size: 0.88rem;
    }
  }
</style>
