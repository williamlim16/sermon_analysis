    display: flex;
    align-items: center;
  }

  .badge {
    background: #e0e7ff;
    color: #4f46e5;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    border: 1px solid #c7d2fe;
    text-transform: uppercase;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
