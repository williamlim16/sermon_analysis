    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    margin: 0 !important;
    font-size: 1.25rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    line-height: 1.25 !important;
    letter-spacing: -0.01em;
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }

  .subtitle {
    color: #475569 !important;
    font-size: 0.875rem !important;
    margin: 0 !important;
    line-height: 1.4 !important;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .avg-score {
    background: #fef3c7;
    color: #b45309;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #fde68a;
    display: inline-flex;
    align-items: baseline;
    gap: 0.1rem;
  }

  .avg-score small {
    font-size: 0.75em;
    font-weight: 600;
    color: #92400e;
  }

  .toggle-btn {
    background: transparent;
    color: #64748b;
    border: none;
    padding: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .btn-text {
    display: inline-block;
  }

  .judgements-header:hover .toggle-btn {
    color: #0f172a;
  }

  .chevron {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .judgements-card.is-expanded .chevron {
    transform: rotate(180deg);
  }

  .content-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    opacity: 0;
  }

  .judgements-card.is-expanded .content-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .content-inner {
    overflow: hidden;
  }

  .tabs-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1.25rem 1.75rem 0.5rem 1.75rem;
    background: #ffffff;
    border-bottom: 1px solid #f1f5f9;
  }

  .tab-btn {
    background: #f8fafc;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.4rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .tab-btn.is-active {
    background: #4f46e5;
    color: #ffffff;
    border-color: #4338ca;
  }

  .tab-score {
    font-size: 0.75rem;
    opacity: 0.85;
    background: rgba(0, 0, 0, 0.08);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
  }

  .tab-btn.is-active .tab-score {
    background: rgba(255, 255, 255, 0.2);
  }

  .panes-container {
    padding: 1.5rem 1.75rem 2.25rem 1.75rem;
  }

  .model-pane {
    display: none;
    animation: fadeIn 0.2s ease-in-out;
  }

  .model-pane.is-active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .model-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    font-size: 0.82rem;
    color: #64748b;
  }

  .provider {
    font-weight: 700;
    text-transform: uppercase;
    color: #6366f1;
    background: #e0e7ff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.72rem;
  }

  .full-model {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .summary-section {
    margin-bottom: 2rem;
    border-left: 3px solid #6366f1;
    padding-left: 1.25rem;
  }

  .summary-text {
    margin: 0 !important;
    font-size: 1.08rem;
    line-height: 1.7;
    color: #1e293b;
    font-weight: 500;
  }

  .feedback-group {
    margin-bottom: 2rem;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.02rem !important;
    font-weight: 700 !important;
    margin: 0 0 0.85rem 0 !important;
    border-bottom: 1px solid #f1f5f9 !important;
    padding-bottom: 0.4rem !important;
  }

  .text-emerald { color: #059669 !important; }
  .text-amber { color: #d97706 !important; }
  .text-indigo { color: #4f46e5 !important; }

  .feedback-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .feedback-list li {
    position: relative;
    padding: 0 0 0 1.5rem !important;
    margin: 0 !important;
    font-size: 0.98rem;
    line-height: 1.6;
    color: #334155;
    background: none !important;
    border: none !important;
    box-shadow: none !important;
  }

  .check-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: #059669;
    font-weight: 700;
  }

  .arrow-list li::before {
    content: "•";
    position: absolute;
    left: 0.4rem;
    top: -0.1rem;
    color: #d97706;
    font-size: 1.3rem;
  }

  .analysis-group {
    margin-top: 2.5rem;
    padding-top: 1rem;
  }

  .prose-body {
    color: #334155;
    font-size: 1rem;
    line-height: 1.75;
  }

  .prose-body :global(h1),
  .prose-body :global(h2),
  .prose-body :global(h3),
  .prose-body :global(h4) {
    color: #1e293b !important;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose-body :global(h3:first-child),
  .prose-body :global(h2:first-child),
  .prose-body :global(h1:first-child) {
    margin-top: 0;
  }

  .prose-body :global(p) {
    margin-bottom: 1.25em;
    margin-top: 0;
  }

  .prose-body :global(ul),
  .prose-body :global(ol) {
    list-style: none;
    padding: 0 0 0 0.5rem;
    margin: 0.5rem 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .prose-body :global(li) {
    position: relative;
    padding: 0 0 0 1.5rem;
    margin: 0;
    color: #475569;
    line-height: 1.5;
  }

  .prose-body :global(li::before) {
    content: "•";
    position: absolute;
    left: 0.25rem;
    top: -0.05rem;
    color: #6366f1;
    font-size: 1.25rem;
  }

  .prose-body :global(strong),
  .prose-body :global(b) {
    color: #0f172a;
    font-weight: 600;
  }

