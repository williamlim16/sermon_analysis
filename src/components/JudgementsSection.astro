---
import { marked } from 'marked';

interface JudgementItem {
  model: string;
  score?: number;
  content?: string;
  summary?: string;
  strengths?: string[];
  detailed_evaluation?: string;
  areas_for_improvement?: string[];
}

interface Props {
  judgements: JudgementItem[] | string;
}

const { judgements = [] } = Astro.props;

let judgementsList: JudgementItem[] = [];
if (typeof judgements === 'string') {
  try {
    judgementsList = JSON.parse(judgements);
  } catch (e) {
    judgementsList = [];
  }
} else if (Array.isArray(judgements)) {
  judgementsList = judgements;
}

if (!judgementsList || judgementsList.length === 0) {
  return null;
}

// Calculate average score
const validScores = judgementsList.filter(j => typeof j?.score === 'number').map(j => j.score!);
const avgScore = validScores.length > 0 
  ? (validScores.reduce((a, b) => a + b, 0) / validScores.length).toFixed(1)
  : null;

const cleanMd = (text: string = '') => text.replace(/\\n/g, '\n').replace(/\. - /g, '.\n- ');

function formatModelName(model: string = '') {
  const parts = model.split('/');
  const rawName = parts.length > 1 ? parts[1] : parts[0];
  const provider = parts.length > 1 ? parts[0] : '';
  
  let cleanName = rawName
    .replace(/-/g, ' ')
    .replace(/\b(?:instruct|chat)\b/gi, '')
    .trim();
    
  cleanName = cleanName.split(' ').map(w => {
    if (w.toLowerCase() === 'llama') return 'Llama';
    if (w.toLowerCase() === 'qwen') return 'Qwen';
    if (w.toLowerCase() === 'deepseek') return 'DeepSeek';
    if (w.toLowerCase() === 'gpt') return 'GPT';
    if (w.toLowerCase() === 'claude') return 'Claude';
    if (w.match(/^[0-9]+b$/i)) return w.toUpperCase();
    return w.charAt(0).toUpperCase() + w.slice(1);
  }).join(' ').replace(/\s+/g, ' ').trim();

  if (!cleanName) cleanName = rawName || 'AI Model';
  return { name: cleanName, provider: provider || 'model' };
}

// Pre-render markdown for detailed evaluation or content
const renderedJudgements = await Promise.all(
  judgementsList.map(async (j, idx) => {
    const formatted = formatModelName(j.model);
    const mdToParse = j.detailed_evaluation ? cleanMd(j.detailed_evaluation) : cleanMd(j.content || '');
    const html = mdToParse ? await marked.parse(mdToParse) : '';
    return {
      ...j,
      idx,
      formattedName: formatted.name,
      provider: formatted.provider,
      html,
    };
  })
);

const sectionId = 'judgements-exp-' + Math.floor(Math.random() * 100000);
---

<div class="judgements-card">
  <div class="judgements-header" role="button" tabindex="0" aria-expanded="false" aria-controls={sectionId}>
    <div class="header-left">
      <div class="badge-wrap">
        <span class="badge">✦ AI REVIEW</span>
      </div>
      <div class="title-group">
        <h3 class="title">Model Judgements</h3>
        <p class="subtitle">Click to expand AI evaluations & feedback</p>
      </div>
    </div>
    <div class="header-right">
      {avgScore && (
        <span class="avg-score">
          ★ {avgScore}<small>/10</small>
        </span>
      )}
      <button type="button" class="toggle-btn" aria-expanded="false" aria-controls={sectionId} tabindex="-1" aria-label="Toggle AI Reviews">
        <span class="btn-text">Expand Reviews</span>
        <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="content-wrapper" id={sectionId} role="region" aria-labelledby="judgements-title">
    <div class="content-inner">
      {renderedJudgements.length > 1 && (
        <div class="tabs-bar" role="tablist">
          {renderedJudgements.map((j, i) => (
            <button 
              type="button"
              class={`tab-btn ${i === 0 ? 'is-active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`pane-${sectionId}-${i}`}
              data-tab-index={i}
            >
              <span>{j.formattedName}</span>
              {typeof j.score === 'number' && (
                <span class="tab-score">{j.score}/10</span>
              )}
            </button>
          ))}
        </div>
      )}

      <div class="panes-container">
        {renderedJudgements.map((j, i) => (
          <div 
            class={`model-pane ${i === 0 ? 'is-active' : ''}`}
            role="tabpanel"
            id={`pane-${sectionId}-${i}`}
            data-pane-index={i}
          >
            <div class="model-meta">
              <span class="provider">{j.provider}</span>
              <span class="full-model">{j.model}</span>
            </div>

            {j.summary && (
              <div class="summary-section">
                <p class="summary-text">{j.summary}</p>
              </div>
            )}

            {j.strengths && j.strengths.length > 0 && (
              <div class="feedback-group">
                <h4 class="group-title text-emerald">
                  <span class="icon">✓</span> Key Strengths
                </h4>
                <ul class="feedback-list check-list">
                  {j.strengths.map((str: string) => (
                    <li>{str}</li>
                  ))}
                </ul>
              </div>
            )}

            {j.areas_for_improvement && j.areas_for_improvement.length > 0 && (
              <div class="feedback-group">
                <h4 class="group-title text-amber">
                  <span class="icon">↗</span> Constructive Feedback
                </h4>
                <ul class="feedback-list arrow-list">
                  {j.areas_for_improvement.map((imp: string) => (
                    <li>{imp}</li>
                  ))}
                </ul>
              </div>
            )}

            {j.html && (
              <div class="analysis-group">
                <h4 class="group-title text-indigo">Detailed Analysis</h4>
                <div class="prose-body" set:html={j.html} />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function setupJudgementsInteractivity() {
    const cards = document.querySelectorAll('.judgements-card');
    cards.forEach((card) => {
      if (card.hasAttribute('data-judgements-init')) return;
      card.setAttribute('data-judgements-init', 'true');

      const header = card.querySelector('.judgements-header');
      const btn = card.querySelector('.toggle-btn');
      const btnText = card.querySelector('.btn-text');
      
      if (header && btn) {
        const toggleExplanation = () => {
          const isExpanded = card.classList.toggle('is-expanded');
          btn.setAttribute('aria-expanded', isExpanded.toString());
          header.setAttribute('aria-expanded', isExpanded.toString());
          if (btnText) {
            btnText.textContent = isExpanded ? 'Collapse Reviews' : 'Expand Reviews';
          }
        };

        header.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.tabs-bar')) return;
          toggleExplanation();
        });
        
        header.addEventListener('keydown', (e) => {
          const keyEvent = e as KeyboardEvent;
          if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
            if ((e.target as HTMLElement).closest('.tabs-bar')) return;
            keyEvent.preventDefault();
            toggleExplanation();
          }
        });
      }

      const tabBtns = card.querySelectorAll('.tab-btn');
      const panes = card.querySelectorAll('.model-pane');

      tabBtns.forEach((tabBtn) => {
        tabBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetIndex = tabBtn.getAttribute('data-tab-index');

          tabBtns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          panes.forEach((p) => p.classList.remove('is-active'));

          tabBtn.classList.add('is-active');
          tabBtn.setAttribute('aria-selected', 'true');

          const activePane = card.querySelector(`.model-pane[data-pane-index="${targetIndex}"]`);
          if (activePane) {
            activePane.classList.add('is-active');
          }
        });
      });
    });
  }

  setupJudgementsInteractivity();
  document.addEventListener('astro:after-swap', setupJudgementsInteractivity);
  document.addEventListener('astro:page-load', setupJudgementsInteractivity);
</script>

<style>
  .judgements-card {
    margin: 2.5rem 0;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #6366f1;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .judgements-header {
    padding: 1.15rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
