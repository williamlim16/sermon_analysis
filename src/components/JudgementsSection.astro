      font-size: 0.68rem;
      padding: 0.25rem 0.65rem;
    }
    .title {
      font-size: 1.08rem !important;
    }
    .subtitle {
      font-size: 0.78rem !important;
    }
    .header-right {
      width: 100%;
      justify-content: space-between;
      border-top: 1px dashed #e2e8f0;
      padding-top: 0.75rem;
    }
    .toggle-btn {
      flex: 1;
      justify-content: center;
      padding: 0.45rem 0.75rem;
      font-size: 0.82rem;
      background: #f1f5f9;
